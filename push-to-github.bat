@echo off
chcp 65001 > nul
title อัปเดตการแก้ไขขึ้น GitHub และเว็บไซต์ Render อัตโนมัติ
echo ======================================================================
echo    ระบบ AUN-QA V4.0: กำลังอัปเดตการแก้ไขขึ้นเว็บไซต์ออนไลน์
echo ======================================================================
echo.

echo [1/3] กำลัง Build ไฟล์หน้าเว็บล่าสุด...
cd client
call npm run build
cd ..

echo.
echo [2/3] กำลังบันทึกการเปลี่ยนแปลงทั้งหมดเข้า Git...
git add .
git commit -m "Update website at %date% %time%"

echo.
echo [3/3] กำลังส่งโค้ดขึ้น GitHub...
git push origin main

if %errorlevel% equ 0 (
    echo.
    echo ======================================================================
    echo  [สำเร็จ 100%!] โค้ดถูกส่งขึ้น GitHub เรียบร้อยแล้ว!
    echo  ระบบ Render จะนำการแก้ไขนี้ไปอัปเดตบนหน้าเว็บจริงให้อัตโนมัติใน 1-2 นาที
    echo ======================================================================
) else (
    echo.
    echo ======================================================================
    echo  [แจ้งเตือน] เกิดข้อผิดพลาดในการเชื่อมต่อกับ GitHub
    echo ======================================================================
)

echo.
pause
