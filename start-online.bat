@echo off
chcp 65001 > nul
title ระบบจัดเก็บข้อมูล AUN-QA V4.0 (เปิดพร้อมลิงก์ออนไลน์ให้อาจารย์)
rem ======================================================================
rem ไฟล์: start-online.bat
rem หน้าที่: เริ่มระบบ Backend + Frontend พร้อมสร้างลิงก์ออนไลน์ Cloudflare Tunnel ในคลิกเดียว
rem ======================================================================

echo ======================================================================
echo    ระบบจัดเก็บข้อมูลและหลักฐานอ้างอิงสำหรับรายงานประเมินตนเอง
echo                    ตามเกณฑ์ AUN-QA Version 4.0
echo             [โหมดเปิดระบบ + สร้างลิงก์ออนไลน์สำหรับอาจารย์]
echo ======================================================================
echo.
echo กำลังเริ่มต้นเซิร์ฟเวอร์...
echo.

rem 1. สตาร์ท Backend API Server (Port 5001)
start "AUN-QA Backend Server" cmd /k "cd server && npm start"

rem หน่วงเวลา 3 วินาที เพื่อให้ Backend พร้อมทำงาน
timeout /t 3 /nobreak > nul

rem 2. สตาร์ท Frontend Client (Port 3000)
start "AUN-QA Frontend Client" cmd /k "cd client && npm run dev"

rem หน่วงเวลา 3 วินาที เพื่อให้ Frontend พร้อมทำงาน
timeout /t 3 /nobreak > nul

echo.
echo ======================================================================
echo  กำลังเชื่อมต่อ Cloudflare Tunnel เพื่อสร้างลิงก์ออนไลน์...
echo.
echo  รอประมาณ 3-5 วินาที ลิงก์ออนไลน์จะปรากฏในกรอบด้านล่างนี้:
echo  (ตัวอย่าง: https://xxxx.trycloudflare.com)
echo.
echo  คัดลอกลิงก์ดังกล่าวส่งให้อาจารย์เปิดในเบราว์เซอร์ได้ทันที!
echo  (โปรดเปิดหน้าต่างนี้ไว้ตลอดช่วงเวลาที่อาจารย์กำลังเข้าใช้งาน)
echo ======================================================================
echo.

cloudflared.exe tunnel --url http://localhost:3000
pause
